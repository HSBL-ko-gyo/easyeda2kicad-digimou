+    ["provider", "distributor_part_number", "manufacturer", "mpn"],
+)
+@pytest.mark.parametrize("value", [True, 123, ["identity"], {"id": "identity"}, ""])
+def test_distributor_record_from_dict_rejects_non_text_identity(
