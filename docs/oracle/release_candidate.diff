+
+
+@dataclass
+class CadRecord:
+    source: str
+    lcsc_part_number: Optional[str] = None
+    easyeda_component_id: Optional[str] = None
+    symbol_name: Optional[str] = None
+    footprint_name: Optional[str] = None
