+    return {
+        "uuid": "easyeda-component-1",
+        "title": "UNTRUSTED_SEARCH_TITLE",
+        "lcsc": {"number": lcsc},
+        "dataStr": {"head": {"c_para": symbol}},
+        "packageDetail": {"dataStr": {"head": {"c_para": package}}},
+    }
+
+
+def test_extracts_agreeing_payload_identity() -> None:
+    result = extract_cad_identity(
